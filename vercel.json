{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/index.php", "use": "vercel-php@0.9.0" }
  ],
  "routes": [
    { "src": "/(assets|templates|uploads|robots.txt)(.*)", "dest": "/arcade_cms/$1$2" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
