{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "arcade_cms/index.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/(assets|templates|uploads|robots.txt)(.*)",
      "dest": "/arcade_cms/$1$2"
    },
    {
      "src": "/(.*)",
      "dest": "/arcade_cms/index.php"
    }
  ]
}
