{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/(assets|templates|uploads|robots.txt)(.*)", "dest": "/arcade_cms/$1$2" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
